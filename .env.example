# Server-only Gemini configuration. Never prefix these with VITE_.
GEMINI_API_KEY=replace-with-a-server-only-key
# Optional comma-separated or JSON-array rotation list.
# GEMINI_API_KEYS=key1,key2,key3
GEMINI_KEY_COOLDOWN_MINUTES=15

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=portfolio
MYSQL_PASSWORD=replace-me
MYSQL_DATABASE=portfolio_db
MYSQL_SSL=false
MYSQL_POOL_LIMIT=2
MYSQL_POOL_QUEUE_LIMIT=20
MYSQL_CONNECT_TIMEOUT_MS=10000
MYSQL_ACQUIRE_TIMEOUT_MS=5000

# Stateful admin session. Generate at least 32 random bytes.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Generate with: npm run admin:hash-password -- "your password"
ADMIN_PASSWORD_HASH=scrypt$replace-with-generated-value
# Plaintext is accepted only for local development.
# ADMIN_PASSWORD=local-development-only

# HMAC identifiers used for rate limits. Rotating the version resets buckets.
RATE_LIMIT_HMAC_KEY=replace-with-a-different-random-secret
RATE_LIMIT_KEY_VERSION=v1

# Exact origins, comma-separated. Same-origin remains the preferred deployment.
ALLOWED_ORIGINS=https://nguyenxuandai.com
PUBLIC_ORIGIN=https://nguyenxuandai.com
CSP_REPORT_ONLY=true

# Server-only EmailJS configuration. Lists rotate together by index.
EMAILJS_PUBLIC_KEY=public-key-1
EMAILJS_PRIVATE_KEY=private-key-1
EMAILJS_SERVICE_ID=service-id-1
EMAILJS_CONTACT_ID=contact-template-id-1
EMAILJS_AUTO_REPLY_ID=reply-template-id-1
EMAIL_PROVIDER_TIMEOUT_MS=10000

# Set these from the real production deployment date (+30 days).
LEGACY_CONTACT_SUNSET=Wed, 30 Sep 2026 00:00:00 GMT
IDEAS_SUNSET=Wed, 30 Sep 2026 00:00:00 GMT
ADMIN_VERIFY_SUNSET=Wed, 30 Sep 2026 00:00:00 GMT
