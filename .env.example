# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=portfolio_db
# Set to 'true' to force TLS (otherwise auto-enabled for *.tidbcloud.com,
# *.aivencloud.com, *.rds.amazonaws.com, *.psdb.cloud)
# MYSQL_SSL=true

# ──────────────────────────────────────────────────────────────────────────────
# Admin / Content System
# ──────────────────────────────────────────────────────────────────────────────
# `ADMIN_TOKEN` is the bearer token stored in the admin user's browser after
# login and required by every POST/PATCH/DELETE endpoint. Generate a long
# random string (e.g. `openssl rand -hex 32`).
#
# `ADMIN_PASSWORD` is what the admin types into the /admin/login form. If
# unset, the login form expects the raw `ADMIN_TOKEN` to be used as the
# password (handy for bootstrapping; you should set a distinct password in
# production).
ADMIN_TOKEN=replace-with-a-long-random-string
ADMIN_PASSWORD=pick-a-strong-password

# EmailJS Configuration (server-side - không lộ ra client)
# Comma-separated lists for rotation every 10 minutes

EMAILJS_PUBLIC_KEY=key1,key2,key3
EMAILJS_SERVICE_ID=service_xunidizan_1,service_xunidizan_2,service_xunidizan_3
EMAILJS_CONTACT_ID=contact_xunidizan_1,contact_xunidizan_2,contact_xunidizan_3
EMAILJS_AUTO_REPLY_ID=reply_xunidizan_1,reply_xunidizan_2,reply_xunidizan_3
